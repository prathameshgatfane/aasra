<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @animal.name %> - Animal Details</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
    <!-- Navbar content here -->
  </nav>

  <!-- Animal Details -->
  <section class="py-5">
    <div class="container">
      <h2 class="text-center"><%= @animal.name %></h2>
      <p class="text-center"><%= @animal.age %> years old</p>
      <div class="row">
        <div class="col-md-6">
          <img src="<%= @animal.image_url %>" alt="<%= @animal.name %>" class="img-fluid">
        </div>
        <div class="col-md-6">
          <p><strong>Breed:</strong> <%= @animal.breed.name %></p>
          <p><strong>Category:</strong> <%= @animal.category.name %></p>
          <p><strong>Shelter:</strong> <%= @animal.shelter.name %></p>
          <p><strong>Status:</strong> <%= @animal.adoption_status.humanize %></p>
          <%= link_to "Adopt", adopt_animal_path(@animal), class: "btn btn-primary" %> <!-- Update this path if needed -->
        </div>
      </div>
    </div>
  </section>

  <footer class="bg-light border-top py-5">
    <!-- Footer content here -->
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
