<h2>Sign up</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <!-- Role Selection -->
  <div class="field">
  <%= f.label :role_name, "Register as" %><br>
  <%= f.select :role_name,
        options_for_select(["shelter", "rescuer", "donor"].map { |r| [r.titleize, r] }),
        { prompt: "Select role" },
        required: true %>
</div>


  <!-- Full Name -->
  <div class="field">
    <%= f.label :full_name, "Full Name" %><br />
    <%= f.text_field :full_name, required: true %>
  </div>

  <!-- Phone Number -->
  <div class="field">
    <%= f.label :phone_number, "Phone Number" %><br />
    <%= f.telephone_field :phone_number, required: true %>
  </div>

  <!-- Address -->
  <div class="field">
    <%= f.label :address, "Address" %><br />
    <%= f.text_area :address, rows: 2, required: true %>
  </div>

  <!-- Email -->
  <div class="field">
    <%= f.label :email %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true %>
  </div>

  <!-- Password -->
  <div class="field">
    <%= f.label :password %>
    <% if @minimum_password_length %>
      <em>(<%= @minimum_password_length %> characters minimum)</em>
    <% end %><br />
    <%= f.password_field :password, autocomplete: "new-password", required: true %>
  </div>

  <!-- Password Confirmation -->
  <div class="field">
    <%= f.label :password_confirmation %><br />
    <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true %>
  </div>

  <!-- Submit Button -->
  <div class="actions">
    <%= f.submit "Sign up" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
