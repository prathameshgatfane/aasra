<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Events - PawsomeRescue</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="style.css">
</head>
<body>
  

  <!-- Header -->
  <header class="bg-purple-soft py-5">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6">
          <h1 class="display-5 fw-bold mb-3">Upcoming Events</h1>
          <p class="lead mb-4">Join us for adoption events, fundraisers, and educational workshops. Connect with fellow animal lovers and help make a difference in the lives of animals in need.</p>
          <div class="d-flex gap-2">
            <a href="#adoption-events" class="btn btn-outline-purple">Adoption Events</a>
            <a href="#fundraisers" class="btn btn-outline-teal">Fundraisers</a>
          </div>
        </div>
        <div class="col-lg-6 mt-4 mt-lg-0">
          <img src="https://images.unsplash.com/photo-1452960962994-acf4fd70b632?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Pet adoption event" class="img-fluid rounded-3 shadow">
        </div>
      </div>
    </div>
  </header>

  <!-- Featured Event -->
  <section class="py-5">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-10">
          <div class="card border-0 shadow-sm overflow-hidden">
            <div class="row g-0">
              <div class="col-md-5">
                <img src="https://images.unsplash.com/photo-1469041797191-50ace28483c3?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Spring Adoption Festival" class="img-fluid h-100" style="object-fit: cover;">
              </div>
              <div class="col-md-7">
                <div class="card-body p-4">
                  <div class="d-flex align-items-center mb-3">
                    <span class="badge bg-teal me-2">Featured Event</span>
                    <span class="badge bg-orange-soft text-orange">Adoption Event</span>
                  </div>
                  <h2 class="card-title h3">Spring Adoption Festival</h2>
                  <div class="d-flex align-items-center text-muted mb-3">
                    <i class="bi bi-calendar-event me-2"></i>
                    <span>Saturday, May 15, 2025 • 10:00 AM - 4:00 PM</span>
                  </div>
                  <div class="d-flex align-items-center text-muted mb-3">
                    <i class="bi bi-geo-alt me-2"></i>
                    <span>Central Park Pavilion, 123 Park Ave, Animal City</span>
                  </div>
                  <p class="card-text">Join us for our biggest adoption event of the season! Over 50 adoptable animals, family-friendly activities, food trucks, and more. Reduced adoption fees for all animals during this special event.</p>
                  <div class="d-flex gap-2 mt-4">
                    <a href="#" class="btn btn-teal">Learn More & RSVP</a>
                    <a href="#" class="btn btn-outline-teal">Add to Calendar</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Adoption Events -->
  <section id="adoption-events" class="py-5 bg-light">
    <div class="container">
      <h2 class="text-center mb-5">Adoption Events</h2>
      <div class="row g-4">
        <div class="col-md-6">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4">
              <h3 class="h5 card-title">Weekend Adoption Hours</h3>
              <div class="d-flex align-items-center text-muted mb-3">
                <i class="bi bi-calendar-event me-2"></i>
                <span>Every Saturday & Sunday • 11:00 AM - 3:00 PM</span>
              </div>
              <div class="d-flex align-items-center text-muted mb-3">
                <i class="bi bi-geo-alt me-2"></i>
                <span>Main Shelter, 123 Rescue Lane</span>
              </div>
              <p class="card-text">Our shelter is open for adoptions every weekend. Come meet our available animals and find your perfect match!</p>
              <a href="#" class="btn btn-outline-teal mt-3">View Available Animals</a>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4">
              <h3 class="h5 card-title">PetSmart Adoption Day</h3>
              <div class="d-flex align-items-center text-muted mb-3">
                <i class="bi bi-calendar-event me-2"></i>
                <span>First Saturday of Each Month • 12:00 PM - 4:00 PM</span>
              </div>
              <div class="d-flex align-items-center text-muted mb-3">
                <i class="bi bi-geo-alt me-2"></i>
                <span>PetSmart, 456 Shopping Center Blvd</span>
              </div>
              <p class="card-text">Meet adoptable dogs and cats at our monthly PetSmart adoption event. Volunteers will be on hand to answer questions.</p>
              <a href="#" class="btn btn-outline-teal mt-3">Learn More</a>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4">
              <h3 class="h5 card-title">Yappy Hour at Barking Dog Cafe</h3>
              <div class="d-flex align-items-center text-muted mb-3">
                <i class="bi bi-calendar-event me-2"></i>
                <span>June 10, 2025 • 5:00 PM - 8:00 PM</span>
              </div>
              <div class="d-flex align-items-center text-muted mb-3">
                <i class="bi bi-geo-alt me-2"></i>
                <span>Barking Dog Cafe, 789 Main Street</span>
              </div>
              <p class="card-text">Join us for a pet-friendly happy hour! Meet adoptable dogs, enjoy drink specials, and 15% of proceeds benefit PawsomeRescue.</p>
              <a href="#" class="btn btn-outline-teal mt-3">Learn More</a>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4">
              <h3 class="h5 card-title">Senior Pets for Senior Citizens</h3>
              <div class="d-flex align-items-center text-muted mb-3">
                <i class="bi bi-calendar-event me-2"></i>
                <span>July 15, 2025 • 1:00 PM - 4:00 PM</span>
              </div>
              <div class="d-flex align-items-center text-muted mb-3">
                <i class="bi bi-geo-alt me-2"></i>
                <span>Senior Community Center, 321 Oak Street</span>
              </div>
              <p class="card-text">A special adoption event pairing senior pets with senior citizens. Reduced adoption fees and ongoing support provided.</p>
              <a href="#" class="btn btn-outline-teal mt-3">Learn More</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Fundraisers -->
  <section id="fundraisers" class="py-5">
    <div class="container">
      <h2 class="text-center mb-5">Fundraising Events</h2>
      <div class="row g-4">
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <img src="https://images.unsplash.com/photo-1452378174528-3090a4bba7b2?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" class="card-img-top" style="height: 200px; object-fit: cover;" alt="Paws & Pints">
            <div class="card-body p-4">
              <h3 class="h5 card-title">Paws & Pints</h3>
              <div class="d-flex align-items-center text-muted mb-3">
                <i class="bi bi-calendar-event me-2"></i>
                <span>August 5, 2025 • 6:00 PM - 9:00 PM</span>
              </div>
              <div class="d-flex align-items-center text-muted mb-3">
                <i class="bi bi-geo-alt me-2"></i>
                <span>Riverside Brewing Company</span>
              </div>
              <p class="card-text">Enjoy craft beer tastings, live music, and silent auction. Tickets are $30 and include two drink tickets and appetizers.</p>
            </div>
            <div class="card-footer bg-white border-top-0 pt-0">
              <div class="d-grid">
                <a href="#" class="btn btn-outline-purple">Purchase Tickets</a>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <img src="https://images.unsplash.com/photo-1501286353178-1ec881214838?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" class="card-img-top" style="height: 200px; object-fit: cover;" alt="Annual Gala">
            <div class="card-body p-4">
              <h3 class="h5 card-title">Annual Gala: A Night for Paws</h3>
              <div class="d-flex align-items-center text-muted mb-3">
                <i class="bi bi-calendar-event me-2"></i>
                <span>September 25, 2025 • 7:00 PM - 11:00 PM</span>
              </div>
              <div class="d-flex align-items-center text-muted mb-3">
                <i class="bi bi-geo-alt me-2"></i>
                <span>Grand Hotel Ballroom</span>
              </div>
              <p class="card-text">Our elegant annual fundraising gala featuring dinner, dancing, live and silent auctions, and inspiring animal rescue stories.</p>
            </div>
            <div class="card-footer bg-white border-top-0 pt-0">
              <div class="d-grid">
                <a href="#" class="btn btn-outline-purple">Purchase Tickets</a>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <img src="https://images.unsplash.com/photo-1485833077593-4278bba3f11f?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" class="card-img-top" style="height: 200px; object-fit: cover;" alt="Charity Run">
            <div class="card-body p-4">
              <h3 class="h5 card-title">5K Paws on the Pavement</h3>
              <div class="d-flex align-items-center text-muted mb-3">
                <i class="bi bi-calendar-event me-2"></i>
                <span>October 10, 2025 • 8:00 AM</span>
              </div>
              <div class="d-flex align-items-center text-muted mb-3">
                <i class="bi bi-geo-alt me-2"></i>
                <span>Riverside Park</span>
              </div>
              <p class="card-text">Dog-friendly 5K run/walk to raise funds for medical care for shelter animals. Registration includes t-shirt and swag bag.</p>
            </div>
            <div class="card-footer bg-white border-top-0 pt-0">
              <div class="d-grid">
                <a href="#" class="btn btn-outline-purple">Register Now</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Educational Workshops -->
  <section class="py-5 bg-light">
    <div class="container">
      <h2 class="text-center mb-5">Educational Workshops</h2>
      <div class="row g-4">
        <div class="col-md-6">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4">
              <span class="badge bg-teal-soft text-teal mb-3">Free Workshop</span>
              <h3 class="h5 card-title">Pet First Aid & CPR</h3>
              <div class="d-flex align-items-center text-muted mb-3">
                <i class="bi bi-calendar-event me-2"></i>
                <span>June 22, 2025 • 1:00 PM - 3:00 PM</span>
              </div>
              <div class="d-flex align-items-center text-muted mb-3">
                <i class="bi bi-geo-alt me-2"></i>
                <span>Main Shelter Education Room</span>
              </div>
              <p class="card-text">Learn basic pet first aid and CPR skills that could save your pet's life in an emergency. Taught by a certified veterinary technician.</p>
              <a href="#" class="btn btn-outline-teal mt-3">Register</a>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4">
              <span class="badge bg-teal-soft text-teal mb-3">$15 Fee</span>
              <h3 class="h5 card-title">Basic Dog Training</h3>
              <div class="d-flex align-items-center text-muted mb-3">
                <i class="bi bi-calendar-event me-2"></i>
                <span>Wednesdays, July 5-26, 2025 • 6:00 PM - 7:00 PM</span>
              </div>
              <div class="d-flex align-items-center text-muted mb-3">
                <i class="bi bi-geo-alt me-2"></i>
                <span>Main Shelter Training Yard</span>
              </div>
              <p class="card-text">Four-week course teaching basic commands and manners for dogs. Perfect for new dog owners or those looking to brush up on training.</p>
              <a href="#" class="btn btn-outline-teal mt-3">Register</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Host an Event -->
  <section class="py-5">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6">
          <h2 class="mb-4">Host an Event for PawsomeRescue</h2>
          <p class="lead mb-4">Want to organize your own event to benefit our animals? We'd love to partner with you!</p>
          <p>Whether you're a business looking to host a fundraiser, a school planning a service project, or an individual with a creative idea, we can help make your event a success.</p>
          <p>Some ideas for events include:</p>
          <ul class="mb-4">
            <li>Donation drives at your workplace</li>
            <li>Percentage nights at restaurants or shops</li>
            <li>Birthday fundraisers instead of gifts</li>
            <li>School penny wars or supply drives</li>
            <li>Neighborhood or community fundraising events</li>
          </ul>
          <a href="#" class="btn btn-teal">Contact Us About Hosting an Event</a>
        </div>
        <div class="col-lg-6 mt-4 mt-lg-0">
          <img src="https://images.unsplash.com/photo-1439886183900-e79ec0057170?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Community fundraiser" class="img-fluid rounded-3 shadow">
        </div>
      </div>
    </div>
  </section>

  

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Custom JS -->
  <script src="aasra.js"></script>
</body>
</html>
