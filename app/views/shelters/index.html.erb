
<!-- Header -->
<header class="bg-purple-soft py-5">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <h1 class="display-5 fw-bold mb-3">Our Network of Shelters</h1>
        <p class="lead mb-4">AASRA maintains a network of safe, clean, and compassionate shelters across the region. Find your nearest location to adopt, volunteer, or drop off donations.</p>
        <div class="d-flex gap-2">
          <a href="#map-section" class="btn btn-outline-purple">Find Nearest Shelter</a>
          <a href="volunteer.html" class="btn btn-outline-teal">Volunteer at a Shelter</a>
        </div>
      </div>
      <div class="col-lg-6 mt-4 mt-lg-0">
        <img src="https://images.unsplash.com/photo-1721322800607-8c38375eef04?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Animal shelter" class="img-fluid rounded-3 shadow">
      </div>
    </div>
  </div>
</header>

<<!-- Map Section -->
<section id="map-section" class="py-5">
  <div class="container">
    <h2 class="text-center mb-4">Find a Shelter Near You</h2>
    <div class="row">
      <div class="col-lg-8 mx-auto">
        <div class="bg-light p-3 rounded shadow-sm mb-4">
          <div class="input-group">
            <input type="text" class="form-control" placeholder="Enter your zip code">
            <button class="btn btn-teal" id="zip-search-btn">Search</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Real Leaflet Map -->
    <div class="row">
      <div class="col-12">
        <div id="shelter-map" class="rounded shadow-sm" style="height: 400px;"></div>
      </div>
    </div>
  </div>
</section>

<!-- Leaflet Map Script -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Initialize map
    var map = L.map('shelter-map').setView([20.5937, 78.9629], 5); // Centered on India

    // Add tile layer from OpenStreetMap
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    // Example static shelter markers
    const shelters = [
      {
        name: "Mumbai Shelter",
        lat: 19.0760,
        lng: 72.8777,
        address: "Marine Lines, Mumbai"
      },
      {
        name: "Pune Shelter",
        lat: 18.5204,
        lng: 73.8567,
        address: "FC Road, Pune"
      }
    ];

    // Loop through and add markers
    shelters.forEach(function(shelter) {
      L.marker([shelter.lat, shelter.lng])
        .addTo(map)
        .bindPopup(`<strong>${shelter.name}</strong><br>${shelter.address}`);
    });
  });
</script>
<script>
  document.getElementById("zip-search-btn").addEventListener("click", function () {
    const zip = document.querySelector("input[type='text']").value;

    fetch(`/shelters/near/${zip}`)
      .then(response => response.json())
      .then(data => {
        if (data.error) {
          alert(data.error);
          return;
        }

        // Clear old markers
        if (window.shelterMarkers) {
          window.shelterMarkers.forEach(m => map.removeLayer(m));
        }

        window.shelterMarkers = [];

        if (data.length > 0) {
          const first = data[0];
          map.setView([first.latitude, first.longitude], 11);

          data.forEach(shelter => {
            const marker = L.marker([shelter.latitude, shelter.longitude])
              .addTo(map)
              .bindPopup(`<strong>${shelter.name}</strong><br>${shelter.address}`);
            window.shelterMarkers.push(marker);
          });
        } else {
          alert("No shelters found nearby.");
        }
      })
      .catch(err => {
        alert("Error fetching shelters.");
        console.error(err);
      });
  });
</script>



<!-- Featured Shelters -->

  <section class="py-5 bg-light">
    <div class="container">
      <h2 class="text-center mb-5">Our Shelter Locations</h2>
      <div class="row g-4">
      <% @shelters.each do |shelter| %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <img src="https://images.unsplash.com/photo-1649972904349-6e44c42644a7?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" class="card-img-top" style="height: 200px; object-fit: cover;" alt="Main Shelter">
            <div class="card-body">
              <h3 class="h5 card-title"><%= shelter.name %></h3>
              <p class="card-text"><%= shelter.capacity %> Capacity</p>
              <ul class="list-unstyled">
                <li class="d-flex align-items-center mb-2"><i class="bi bi-geo-alt text-teal me-2"></i> <%= shelter.address %></li>
                <li class="d-flex align-items-center mb-2"><i class="bi bi-telephone text-teal me-2"></i><%= shelter.phone %></li>
              </ul>
            </div>
            <div class="card-footer bg-white border-top-0">
              <div class="d-grid">
                <%= link_to 'View Details', shelter_path(shelter), class: 'btn btn-outline-teal' %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
      </div>
    </div>
  </section>

