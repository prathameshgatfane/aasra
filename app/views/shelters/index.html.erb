
<!-- Header -->
<header class="bg-purple-soft py-5">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <h1 class="display-5 fw-bold mb-3">Our Network of Shelters</h1>
        <p class="lead mb-4">AASRA maintains a network of safe, clean, and compassionate shelters across the region. Find your nearest location to adopt, volunteer, or drop off donations.</p>
        <div class="d-flex gap-2">
          <a href="#map-section" class="btn btn-outline-purple">Find Nearest Shelter</a>
          <a href="volunteer.html" class="btn btn-outline-teal">Volunteer at a Shelter</a>
        </div>
      </div>
      <div class="col-lg-6 mt-4 mt-lg-0">
        <img src="https://images.unsplash.com/photo-1721322800607-8c38375eef04?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Animal shelter" class="img-fluid rounded-3 shadow">
      </div>
    </div>
  </div>
</header>

<!-- Map Section -->
<section id="map-section" class="py-5">
  <div class="container">
    <h2 class="text-center mb-4">Find a Shelter Near You</h2>
    <div class="row">
      <div class="col-lg-8 mx-auto">
        <div class="bg-light p-3 rounded shadow-sm mb-4">
          <div class="input-group">
            <input type="text" class="form-control" placeholder="Enter your zip code">
            <button class="btn btn-teal">Search</button>
          </div>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-12">
        <!-- Placeholder for a map -->
        <div class="bg-light rounded shadow-sm" style="height: 400px; display: flex; align-items: center; justify-content: center;">
          <div class="text-center">
            <i class="bi bi-map fs-1 text-teal mb-3"></i>
            <h3 class="h5">Interactive Map</h3>
            <p class="text-muted">Map will display all shelter locations in our network.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Featured Shelters -->

  <section class="py-5 bg-light">
    <div class="container">
      <h2 class="text-center mb-5">Our Shelter Locations</h2>
      <div class="row g-4">
      <% @shelters.each do |shelter| %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <img src="https://images.unsplash.com/photo-1649972904349-6e44c42644a7?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" class="card-img-top" style="height: 200px; object-fit: cover;" alt="Main Shelter">
            <div class="card-body">
              <h3 class="h5 card-title"><%= shelter.name %></h3>
              <p class="card-text"><%= shelter.capacity %> Capacity</p>
              <ul class="list-unstyled">
                <li class="d-flex align-items-center mb-2"><i class="bi bi-geo-alt text-teal me-2"></i> <%= shelter.address %></li>
                <li class="d-flex align-items-center mb-2"><i class="bi bi-telephone text-teal me-2"></i><%= shelter.phone %></li>
              </ul>
            </div>
            <div class="card-footer bg-white border-top-0">
              <div class="d-grid">
                <%= link_to 'View Details', shelter_path(shelter), class: 'btn btn-outline-teal' %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
      </div>
    </div>
  </section>

<!-- Shelter Features -->
<section class="py-5">
  <div class="container">
    <h2 class="text-center mb-5">What Our Shelters Offer</h2>
    <div class="row g-4">
      <div class="col-md-3">
        <div class="text-center">
          <div class="bg-teal-soft p-3 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
            <i class="bi bi-heart-pulse text-teal fs-1"></i>
          </div>
          <h3 class="h5">Veterinary Care</h3>
          <p class="text-muted">Professional medical services for all shelter animals.</p>
        </div>
      </div>
      <div class="col-md-3">
        <div class="text-center">
          <div class="bg-orange-soft p-3 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
            <i class="bi bi-house-heart text-orange fs-1"></i>
          </div>
          <h3 class="h5">Comfortable Housing</h3>
          <p class="text-muted">Clean, spacious areas designed for animal comfort.</p>
        </div>
      </div>
      <div class="col-md-3">
        <div class="text-center">
          <div class="bg-purple-soft p-3 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
            <i class="bi bi-people text-purple fs-1"></i>
          </div>
          <h3 class="h5">Caring Staff</h3>
          <p class="text-muted">Dedicated professionals who love and care for animals.</p>
        </div>
      </div>
      <div class="col-md-3">
        <div class="text-center">
          <div class="bg-success-soft p-3 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
            <i class="bi bi-dribbble text-success fs-1"></i>
          </div>
          <h3 class="h5">Play Areas</h3>
          <p class="text-muted">Designated spaces for exercise and socialization.</p>
        </div>
      </div>
    </div>
  </div>
</section>