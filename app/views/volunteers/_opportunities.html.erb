<section class="py-5 bg-light">
  <div class="container">
    <h2 class="mb-4 fw-bold text-center">Volunteer Opportunities</h2>
    <div class="row g-4">
      <div class="col-md-3">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h5 class="card-title">Animal Care</h5>
            <p class="card-text">Help feed, groom, and socialize animals in our shelters.</p>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h5 class="card-title">Event Support</h5>
            <p class="card-text">Assist with adoption drives and fundraising events.</p>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h5 class="card-title">Admin Help</h5>
            <p class="card-text">Support with data entry, coordination, and outreach.</p>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h5 class="card-title">Foster</h5>
            <p class="card-text">Temporarily foster animals to provide love and care.</p>
          </div>
        </div>
      </div>
    </div>
    <div class="text-center mt-5">
      <p class="lead">Not sure where you fit in? Get in touch — we’ll help you find your place.</p>
      <%= link_to "Contact Us", contact_path, class: "btn btn-teal" %>
    </div>
  </div>
</section>
