<header class="bg-teal-soft py-5">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <h1 class="display-5 fw-bold mb-3">Volunteer With Us</h1>
        <p class="lead mb-4">Make a difference in the lives of animals by volunteering your time and skills.</p>
        <div class="d-flex gap-2">
          <a href="#opportunities" class="btn btn-teal">Browse Opportunities</a>
          <a href="#application" class="btn btn-outline-teal">Apply Now</a>
        </div>
      </div>
      <div class="col-lg-6 mt-4 mt-lg-0">
        <%= image_tag "https://images.unsplash.com/photo-1535268647677-300dbf3d78d1?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80", alt: "Volunteer with animals", class: "img-fluid rounded-3 shadow" %>
      </div>
    </div>
  </div>
</header>

<%= render "why_volunteer" %>
<%= render "opportunities" %>
<%= render "application_form" %>
<%= render "testimonials" %>
