<!-- Report Animal Section -->
<section id="report-section" class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h2 class="card-title text-center mb-4">Report an Animal in Need</h2>
                        <%= form_with(model: @rescue, local: true) do |f| %>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <%= f.label :image, "Upload Image URL or Filename", class: 'form-label' %>
                                    <%= f.file_field :image, class: "form-control" %>
                                </div>
                                <div class="col-md-6">
                                    <%= f.label :location, class: 'form-label' %>
                                    <%= f.text_field :location, class: "form-control", placeholder: "Address or description of where the animal is located" %>
                                </div>

                                <div class="col-md-6">
                                    <%= f.label :age, class: 'form-label' %>
                                    <%= f.text_field :age, class: "form-control", placeholder: "Age of animal" %>
                                </div>
                                <div class="col-md-6">
                                    <%= f.label :size, class: 'form-label' %>
                                    <%= f.select :size, Rescue.sizes.keys.map { |k| [k.titleize, k] }, { prompt: "Select Size" }, { class: "form-select" } %>
                                </div>
                                <div class="col-md-6">
                                    <%= f.label :category_id, "Category", class: "form-label" %>
                                    <%= f.collection_select :category_id, Category.all, :id, :name, { prompt: "Select Category" }, { class: "form-select", id: "category-select" } %>
                                </div>

                                <div class="col-md-6">
                                    <%= f.label :breed_id, "Breed", class: "form-label" %>
                                    <%= f.select :breed_id, [], { prompt: "Select Breed" }, class: "form-select", id: "breed-select" %>
                                </div>

                                <div class="col-md-6">
                                    <%= f.label :description, "Describe the Situation", class: 'form-label' %>
                                    <%= f.text_area :description, class: "form-control", rows: 4 %>
                                </div>
                                <%= f.submit "Submit Rescue", class: "btn btn-primary" %>
                            </div>
                        <% end %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const categorySelect = document.getElementById("category-select");
    const breedSelect = document.getElementById("breed-select");
    categorySelect.addEventListener("change", function () {
      const categoryId = this.value;
      breedSelect.innerHTML = '<option value="">Loading...</option>';

      fetch('/categories/' + categoryId + '/breeds')
        .then(response => response.json())
        .then(data => {
          breedSelect.innerHTML = '<option value="">Select Breed</option>';
          data.forEach(breed => {
            const option = document.createElement("option");
            option.value = breed.id;
            option.text = breed.name;
            breedSelect.appendChild(option);
          });
        });
    });
  });
</script>