<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Foster Program - PawsomeRescue</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="style.css">
</head>
<body>
  

  <!-- Header -->
  <header class="bg-orange-soft py-5">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6">
          <h1 class="display-5 fw-bold mb-3">Foster an Animal</h1>
          <p class="lead mb-4">Open your home to an animal in need and help them prepare for their forever home. Fostering saves lives and provides animals with needed socialization and care.</p>
          <div class="d-flex gap-2">
            <a href="#animals-needing-foster" class="btn btn-outline-orange">See Animals Needing Foster</a>
            <a href="#apply" class="btn btn-outline-teal">Apply to Foster</a>
          </div>
        </div>
        <div class="col-lg-6 mt-4 mt-lg-0">
          <img src="https://images.unsplash.com/photo-1535241749838-299277b6305f?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Fostering animals" class="img-fluid rounded-3 shadow">
        </div>
      </div>
    </div>
  </header>

  <!-- About Fostering -->
  <section class="py-5">
    <div class="container">
      <h2 class="text-center mb-5">What is Fostering?</h2>
      <div class="row g-4">
        <div class="col-md-6">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4">
              <h3 class="h4 mb-3">Why Animals Need Foster Homes</h3>
              <p>Animals may need foster care for many reasons:</p>
              <ul class="mt-3">
                <li>They're too young for adoption</li>
                <li>They need time to recover from illness or injury</li>
                <li>They need socialization or behavior training</li>
                <li>The shelter is at capacity</li>
                <li>They need a break from the stress of shelter life</li>
              </ul>
              <p class="mt-3">By fostering, you provide a safe, temporary home where these animals can thrive until they're ready for adoption.</p>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4">
              <h3 class="h4 mb-3">What to Expect as a Foster</h3>
              <p>As a foster parent, you'll:</p>
              <ul class="mt-3">
                <li>Provide food, shelter, and love</li>
                <li>Help with basic training and socialization</li>
                <li>Take your foster pet to scheduled vet appointments</li>
                <li>Update the rescue on the animal's progress</li>
                <li>Help potential adopters meet your foster pet</li>
              </ul>
              <p class="mt-3">We provide all necessary supplies, medical care, and ongoing support throughout your fostering journey.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Foster Needs -->
  <section id="animals-needing-foster" class="py-5 bg-light">
    <div class="container">
      <h2 class="text-center mb-5">Animals Currently Needing Foster Homes</h2>
      <div class="row g-4">
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm animal-card">
            <div class="animal-image-container">
              <img src="https://images.unsplash.com/photo-1552053831-71594a27632d?ixlib=rb-4.0.3&auto=format&fit=crop&w=640&q=80" alt="Buddy" class="animal-image">
              <span class="badge badge-species position-absolute">Dog</span>
            </div>
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                  <h3 class="h5 fw-semibold mb-0">Buddy</h3>
                  <p class="text-secondary small mb-0">Beagle Mix · 1 year</p>
                </div>
                <span class="badge border badge-gender">Male</span>
              </div>
              <p class="mt-3">Buddy needs a foster home for 6-8 weeks while he recovers from a leg injury. He's great with other dogs and children.</p>
              <div class="d-flex flex-wrap mt-3">
                <span class="badge badge-tag">Friendly</span>
                <span class="badge badge-tag">Medical Recovery</span>
                <span class="badge badge-tag">Short-term</span>
              </div>
            </div>
            <div class="card-footer bg-white border-top-0 pt-0">
              <div class="d-grid">
                <a href="#apply" class="btn btn-outline-teal">Apply to Foster Buddy</a>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm animal-card">
            <div class="animal-image-container">
              <img src="https://images.unsplash.com/photo-1582562124811-c09040d0a901?ixlib=rb-4.0.3&auto=format&fit=crop&w=640&q=80" alt="Mittens and kittens" class="animal-image">
              <span class="badge badge-species position-absolute">Cat</span>
            </div>
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                  <h3 class="h5 fw-semibold mb-0">Mittens + 4 Kittens</h3>
                  <p class="text-secondary small mb-0">Tabby · Mom + Babies</p>
                </div>
                <span class="badge border badge-gender">Female</span>
              </div>
              <p class="mt-3">Mother cat and her 4 week old kittens need a quiet foster home until the kittens are ready for adoption (approximately 8 weeks).</p>
              <div class="d-flex flex-wrap mt-3">
                <span class="badge badge-tag">Nursing Mom</span>
                <span class="badge badge-tag">Kittens</span>
                <span class="badge badge-tag">Medium-term</span>
              </div>
            </div>
            <div class="card-footer bg-white border-top-0 pt-0">
              <div class="d-grid">
                <a href="#apply" class="btn btn-outline-teal">Apply to Foster Mittens & Kittens</a>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm animal-card">
            <div class="animal-image-container">
              <img src="https://images.unsplash.com/photo-1568640347023-a616a30bc3bd?ixlib=rb-4.0.3&auto=format&fit=crop&w=640&q=80" alt="Rocky" class="animal-image">
              <span class="badge badge-species position-absolute">Dog</span>
            </div>
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                  <h3 class="h5 fw-semibold mb-0">Rocky</h3>
                  <p class="text-secondary small mb-0">Pit Bull Mix · 3 years</p>
                </div>
                <span class="badge border badge-gender">Male</span>
              </div>
              <p class="mt-3">Rocky needs a foster home with someone experienced with shy dogs. He needs help with socialization and basic training.</p>
              <div class="d-flex flex-wrap mt-3">
                <span class="badge badge-tag">Shy</span>
                <span class="badge badge-tag">Training Needed</span>
                <span class="badge badge-tag">Long-term</span>
              </div>
            </div>
            <div class="card-footer bg-white border-top-0 pt-0">
              <div class="d-grid">
                <a href="#apply" class="btn btn-outline-teal">Apply to Foster Rocky</a>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="text-center mt-5">
        <a href="#" class="btn btn-teal">View More Animals Needing Fosters</a>
      </div>
    </div>
  </section>

  <!-- Foster Types -->
  <section class="py-5">
    <div class="container">
      <h2 class="text-center mb-5">Types of Foster Opportunities</h2>
      <div class="row g-4">
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm text-center">
            <div class="card-body p-4">
              <div class="bg-teal-soft p-3 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-calendar2-heart text-teal fs-1"></i>
              </div>
              <h3 class="h4 mb-3">Short-Term</h3>
              <p class="text-muted">Temporary care for a few days to a few weeks, often for animals recovering from surgery or waiting for transport.</p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm text-center">
            <div class="card-body p-4">
              <div class="bg-orange-soft p-3 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-clipboard2-pulse text-orange fs-1"></i>
              </div>
              <h3 class="h4 mb-3">Medical Recovery</h3>
              <p class="text-muted">Care for animals recovering from illness or injury who need a quiet place to heal before finding their forever home.</p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm text-center">
            <div class="card-body p-4">
              <div class="bg-purple-soft p-3 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-house-heart text-purple fs-1"></i>
              </div>
              <h3 class="h4 mb-3">Maternity</h3>
              <p class="text-muted">Provide a safe and quiet space for pregnant animals to give birth and care for their newborns.</p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm text-center">
            <div class="card-body p-4">
              <div class="bg-success-soft p-3 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-activity text-success fs-1"></i>
              </div>
              <h3 class="h4 mb-3">Behavioral</h3>
              <p class="text-muted">Help animals with minor behavioral issues that make shelter life difficult, such as fear, anxiety, or lack of socialization.</p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm text-center">
            <div class="card-body p-4">
              <div class="bg-teal-soft p-3 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-balloon-heart text-teal fs-1"></i>
              </div>
              <h3 class="h4 mb-3">Bottle Baby</h3>
              <p class="text-muted">Care for orphaned, newborn puppies or kittens who need bottle feeding and round-the-clock care.</p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm text-center">
            <div class="card-body p-4">
              <div class="bg-orange-soft p-3 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-stars text-orange fs-1"></i>
              </div>
              <h3 class="h4 mb-3">Hospice</h3>
              <p class="text-muted">Provide love and comfort to senior or terminally ill animals, giving them a peaceful and loving end of life experience.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Foster Application -->
  <section id="apply" class="py-5 bg-light">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
              <h2 class="card-title text-center mb-4">Foster Application</h2>
              <form>
                <div class="row g-3">
                  <div class="col-md-6">
                    <label for="firstName" class="form-label">First Name</label>
                    <input type="text" class="form-control" id="firstName" required>
                  </div>
                  <div class="col-md-6">
                    <label for="lastName" class="form-label">Last Name</label>
                    <input type="text" class="form-control" id="lastName" required>
                  </div>
                  <div class="col-md-6">
                    <label for="email" class="form-label">Email Address</label>
                    <input type="email" class="form-control" id="email" required>
                  </div>
                  <div class="col-md-6">
                    <label for="phone" class="form-label">Phone Number</label>
                    <input type="tel" class="form-control" id="phone" required>
                  </div>
                  <div class="col-12">
                    <label for="address" class="form-label">Address</label>
                    <input type="text" class="form-control" id="address" required>
                  </div>
                  <div class="col-md-4">
                    <label for="city" class="form-label">City</label>
                    <input type="text" class="form-control" id="city" required>
                  </div>
                  <div class="col-md-4">
                    <label for="state" class="form-label">State</label>
                    <select class="form-select" id="state" required>
                      <option value="" selected disabled>Select State</option>
                      <option value="AL">Alabama</option>
                      <!-- Add all states here -->
                      <option value="WY">Wyoming</option>
                    </select>
                  </div>
                  <div class="col-md-4">
                    <label for="zip" class="form-label">Zip Code</label>
                    <input type="text" class="form-control" id="zip" required>
                  </div>
                  
                  <div class="col-md-6">
                    <label for="housingType" class="form-label">Housing Type</label>
                    <select class="form-select" id="housingType" required>
                      <option value="" selected disabled>Select Housing Type</option>
                      <option value="house">House</option>
                      <option value="apartment">Apartment</option>
                      <option value="condo">Condo</option>
                      <option value="other">Other</option>
                    </select>
                  </div>
                  
                  <div class="col-md-6">
                    <label for="ownership" class="form-label">Do you rent or own?</label>
                    <div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="ownership" id="own" value="own" required>
                        <label class="form-check-label" for="own">Own</label>
                      </div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="ownership" id="rent" value="rent">
                        <label class="form-check-label" for="rent">Rent</label>
                      </div>
                    </div>
                  </div>
                  
                  <div class="col-12" id="landlordSection" style="display: none;">
                    <label for="landlordContact" class="form-label">Landlord's Contact Information</label>
                    <input type="text" class="form-control" id="landlordContact">
                    <div class="form-text">We may contact your landlord to confirm pet policies.</div>
                  </div>
                  
                  <div class="col-12">
                    <label for="householdMembers" class="form-label">Who lives in your household?</label>
                    <textarea class="form-control" id="householdMembers" rows="2" placeholder="List all adults, children, and their ages"></textarea>
                  </div>
                  
                  <div class="col-md-6">
                    <label for="currentPets" class="form-label">Do you have other pets?</label>
                    <div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="hasPets" id="petsYes" value="yes" required>
                        <label class="form-check-label" for="petsYes">Yes</label>
                      </div>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="hasPets" id="petsNo" value="no">
                        <label class="form-check-label" for="petsNo">No</label>
                      </div>
                    </div>
                  </div>
                  
                  <div class="col-md-6" id="currentPetsSection" style="display: none;">
                    <label for="currentPets" class="form-label">Please describe your current pets</label>
                    <textarea class="form-control" id="currentPets" rows="2" placeholder="Species, breed, age, temperament"></textarea>
                  </div>
                  
                  <div class="col-12">
                    <label class="form-label">What types of animals are you interested in fostering?</label>
                    <div class="row g-2">
                      <div class="col-md-3">
                        <div class="form-check">
                          <input class="form-check-input" type="checkbox" id="fosterDogs">
                          <label class="form-check-label" for="fosterDogs">Dogs</label>
                        </div>
                      </div>
                      <div class="col-md-3">
                        <div class="form-check">
                          <input class="form-check-input" type="checkbox" id="fosterPuppies">
                          <label class="form-check-label" for="fosterPuppies">Puppies</label>
                        </div>
                      </div>
                      <div class="col-md-3">
                        <div class="form-check">
                          <input class="form-check-input" type="checkbox" id="fosterCats">
                          <label class="form-check-label" for="fosterCats">Cats</label>
                        </div>
                      </div>
                      <div class="col-md-3">
                        <div class="form-check">
                          <input class="form-check-input" type="checkbox" id="fosterKittens">
                          <label class="form-check-label" for="fosterKittens">Kittens</label>
                        </div>
                      </div>
                      <div class="col-md-3">
                        <div class="form-check">
                          <input class="form-check-input" type="checkbox" id="fosterBottleBabies">
                          <label class="form-check-label" for="fosterBottleBabies">Bottle Babies</label>
                        </div>
                      </div>
                      <div class="col-md-3">
                        <div class="form-check">
                          <input class="form-check-input" type="checkbox" id="fosterMedical">
                          <label class="form-check-label" for="fosterMedical">Medical Cases</label>
                        </div>
                      </div>
                      <div class="col-md-3">
                        <div class="form-check">
                          <input class="form-check-input" type="checkbox" id="fosterBehavioral">
                          <label class="form-check-label" for="fosterBehavioral">Behavioral Cases</label>
                        </div>
                      </div>
                      <div class="col-md-3">
                        <div class="form-check">
                          <input class="form-check-input" type="checkbox" id="fosterOther">
                          <label class="form-check-label" for="fosterOther">Other</label>
                        </div>
                      </div>
                    </div>
                  </div>
                  
                  <div class="col-12">
                    <label for="fosterExperience" class="form-label">Describe any previous fostering or animal care experience</label>
                    <textarea class="form-control" id="fosterExperience" rows="3"></textarea>
                  </div>
                  
                  <div class="col-12">
                    <label for="specificAnimal" class="form-label">Are you applying for a specific animal?</label>
                    <input type="text" class="form-control" id="specificAnimal" placeholder="If yes, please enter the animal's name">
                  </div>
                  
                  <div class="col-12">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="agreeFoster" required>
                      <label class="form-check-label" for="agreeFoster">
                        I understand that the animals I foster belong to PawsomeRescue and I agree to return them when requested. I also agree to follow all foster program guidelines.
                      </label>
                    </div>
                  </div>
                  
                  <div class="col-12 text-center">
                    <button type="submit" class="btn btn-teal px-4 py-2">Submit Application</button>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Custom JS -->
  <script src="aasra.js"></script>
  <script>
    // Toggle form sections based on selections
    document.querySelector('input[name="ownership"]').addEventListener('change', function() {
      const rentSelected = document.getElementById('rent').checked;
      document.getElementById('landlordSection').style.display = rentSelected ? 'block' : 'none';
    });
    
    document.querySelector('input[name="hasPets"]').addEventListener('change', function() {
      const hasPets = document.getElementById('petsYes').checked;
      document.getElementById('currentPetsSection').style.display = hasPets ? 'block' : 'none';
    });
  </script>
</body>
</html>
