<!-- Header -->
<header class="bg-teal-soft py-5">
  <div class="container text-center">
    <h1 class="fw-bold display-5">Adoption Application</h1>
    <p class="lead mt-3">We’re thrilled you’re considering giving a loving home to one of our animals!</p>
  </div>
</header>

<!-- Adoption Form -->
<section class="py-5 bg-light">
  <div class="container">
    <div class="card shadow-sm p-4 border-0">
      <h2 class="mb-4 text-center text-teal">Request Adoption</h2>

      <%= form_with url: animal_adoptions_path(@animal), model: @adoption_request, local: true do |f| %>

        <!-- Error messages -->
        <% if @adoption_request.errors.any? %>
        <div class="alert alert-danger">
          <h5>There were some problems with your submission:</h5>
          <ul>
            <% @adoption_request.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      

        <!-- Displaying current user info (already stored in DB) -->
        <div class="mb-3">
          <strong>Full Name:</strong> <%= current_user.full_name %><br>
          <strong>Email:</strong> <%= current_user.email %><br>
          <strong>Phone Number:</strong> <%= current_user.phone_number %><br>
          <strong>Address:</strong> <%= current_user.address %>
        </div>

        <hr>

        <!-- Housing type -->
        <div class="mb-3">
          <%= f.label :housing_type, "Housing Type", class: "form-label" %>
          <%= f.select :housing_type, ["Own", "Rent"], {}, class: "form-select", required: true %>
        </div>

        <!-- Existing pets -->
        <div class="mb-3">
        <%= f.label :have_pets, "Do you currently have pets?" %><br>
        <%= f.radio_button :have_pets, true %> Yes
        <%= f.radio_button :have_pets, false %> No
      </div>
      

        <!-- Experience -->
        <div class="mb-3">
          <%= f.label :experience, "Describe your experience with animals", class: "form-label" %>
          <%= f.text_area :experience, class: "form-control", rows: 4, required: true %>
        </div>

        <!-- Preferred pet -->
        <div class="mb-3">
          <%= f.label :preferred_pet, "Which pet are you interested in?", class: "form-label" %>
          <%= f.text_field :preferred_pet, class: "form-control", required: true %>
        </div>

        <!-- Submit button -->
        <div class="mb-3 text-center">
          <%= f.submit "Submit Application", class: "btn btn-teal px-4" %>
        </div>

      <% end %>
    </div>
  </div>
</section>
