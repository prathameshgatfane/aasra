<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Aasra" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
      <div class="container">
        <%= link_to '<i class="bi bi-github text-teal me-2 fs-3"></i><span class="fw-bold">AASRA</span>'.html_safe, root_path, class: "navbar-brand d-flex align-items-center" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <%= link_to '<i class="bi bi-house-door me-1"></i> Home'.html_safe, root_path, class: "nav-link d-flex align-items-center" %>
            </li>
            <li class="nav-item">
              <%= link_to '<i class="bi bi-heart me-1"></i> Adopt'.html_safe, adoptions_path, class: "nav-link d-flex align-items-center" %>
            </li>
            <li class="nav-item">
              <%= link_to '<i class="bi bi-github me-1"></i> Rescue'.html_safe, new_rescue_path, class: "nav-link d-flex align-items-center" %>
            </li>
            <li class="nav-item">
              <%= link_to '<i class="bi bi-people me-1"></i> Shelters'.html_safe, shelters_path, class: "nav-link d-flex align-items-center" %>
            </li>
            <li class="nav-item">
              <%= link_to '<i class="bi bi-currency-dollar me-1"></i> Donate'.html_safe, root_path, class: "nav-link d-flex align-items-center" %>
            </li>
          </ul>
          <div class="d-flex gap-2">
            <% if user_signed_in? %>
              <a class="btn btn-outline-teal"><%= current_user.email %></a>
              <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "btn btn-danger" %>
            <% else %>
              <%= link_to "Login", new_user_session_path, class: "btn btn-outline-teal" %>
              <%= link_to "Register", new_user_registration_path, class: "btn btn-teal text-white" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>
    <%= yield %>
    <!-- Footer -->
    <footer class="bg-light border-top py-5">
      <div class="container">
        <div class="row g-4">
          <div class="col-lg-3 mb-4 mb-lg-0">
            <div class="d-flex align-items-center mb-3">
              <i class="bi bi-github text-teal me-2 fs-3"></i>
              <span class="h4 fw-bold mb-0">AASRA</span>
            </div>
            <p class="text-secondary small">
              Connecting animals in need with loving forever homes since 2023.
            </p>
            <div class="d-flex gap-3 mt-3">
              <a href="#" class="text-secondary hover-text-teal">
                <i class="bi bi-facebook fs-5"></i>
              </a>
              <a href="#" class="text-secondary hover-text-teal">
                <i class="bi bi-twitter fs-5"></i>
              </a>
              <a href="#" class="text-secondary hover-text-teal">
                <i class="bi bi-instagram fs-5"></i>
              </a>
            </div>
          </div>
          
          <div class="col-6 col-md-3">
            <h5 class="small text-uppercase fw-bold mb-3">Navigation</h5>
            <ul class="list-unstyled">
              <li class="mb-2"><a href="index.html" class="text-secondary text-decoration-none hover-text-teal">Home</a></li>
              <li class="mb-2"><a href="adopt.html" class="text-secondary text-decoration-none hover-text-teal">Adopt</a></li>
              <li class="mb-2"><a href="rescue.html" class="text-secondary text-decoration-none hover-text-teal">Rescue</a></li>
              <li class="mb-2"><a href="shelters.html" class="text-secondary text-decoration-none hover-text-teal">Shelters</a></li>
              <li class="mb-2"><a href="donate.html" class="text-secondary text-decoration-none hover-text-teal">Donate</a></li>
            </ul>
          </div>
          
          <div class="col-6 col-md-3">
            <h5 class="small text-uppercase fw-bold mb-3">Get Involved</h5>
            <ul class="list-unstyled">
              <li class="mb-2"><a href="volunteer.html" class="text-secondary text-decoration-none hover-text-teal">Volunteer</a></li>
              <li class="mb-2"><a href="foster.html" class="text-secondary text-decoration-none hover-text-teal">Foster</a></li>
              <li class="mb-2"><a href="events.html" class="text-secondary text-decoration-none hover-text-teal">Events</a></li>
              <li class="mb-2"><a href="success-stories.html" class="text-secondary text-decoration-none hover-text-teal">Success Stories</a></li>
              <li class="mb-2"><a href="resources.html" class="text-secondary text-decoration-none hover-text-teal">Resources</a></li>
            </ul>
          </div>
          
          <div class="col-md-3">
            <h5 class="small text-uppercase fw-bold mb-3">Contact Us</h5>
            <ul class="list-unstyled">
              <li class="d-flex mb-2">
                <i class="bi bi-telephone me-2 text-secondary"></i>
                <span class="text-secondary">(555) 123-4567</span>
              </li>
              <li class="d-flex mb-2">
                <i class="bi bi-envelope me-2 text-secondary"></i>
                <span class="text-secondary">info@pawsomerescue.com</span>
              </li>
              <li class="d-flex">
                <i class="bi bi-geo-alt me-2 text-secondary"></i>
                <span class="text-secondary">123 Rescue Lane<br>Animal City, AC 12345</span>
              </li>
            </ul>
          </div>
        </div>
        
        <div class="border-top pt-4 mt-4 text-center">
          <p class="text-secondary small">
            &copy; <span id="current-year"></span> AASRA. All rights reserved.
          </p>
          <div class="d-flex justify-content-center gap-4">
            <a href="privacy.html" class="text-secondary small text-decoration-none hover-text-teal">Privacy Policy</a>
            <a href="terms.html" class="text-secondary small text-decoration-none hover-text-teal">Terms of Service</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
