<!DOCTYPE html>
<html>
<head>
<title><%= content_for(:title) || "Aasra" %></title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<%= csrf_meta_tags %>
<%= csp_meta_tag %>

<%= yield :head %>

<link rel="manifest" href="/manifest.json">
<link rel="icon" href="/icon.png" type="image/png">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/icon.png">

<!-- Add both application and custom stylesheets -->
<%= stylesheet_link_tag "application", "custom", media: "all", "data-turbo-track": "reload" %>

<%= javascript_importmap_tags %>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
</head>


  <body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
      <div class="container">
        <%= link_to root_path, class: "navbar-brand d-flex align-items-center gap-2" do %>
          <%= image_tag "aasra_logo.jpg", alt: "AASRA Logo", class: "rounded-circle", style: "height: 40px; width: 40px; object-fit: cover;" %>
          <span class="animated-logo-text">AASRA</span>
        <% end %>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <%= link_to '<i class="bi bi-house-door me-1"></i> Home'.html_safe, root_path, class: "nav-link d-flex align-items-center" %>
            </li>
            <li class="nav-item">
              <%= link_to '<i class="bi bi-heart me-1"></i> Adopt'.html_safe, adoptions_path, class: "nav-link d-flex align-items-center" %>
            </li>
            <li class="nav-item">
              <%= link_to '<i class="bi bi-github me-1"></i> Rescue'.html_safe, new_rescue_path, class: "nav-link d-flex align-items-center" %>
            </li>
            <li class="nav-item">
              <%= link_to '<i class="bi bi-people me-1"></i> Shelters'.html_safe, shelters_path, class: "nav-link d-flex align-items-center" %>
            </li>
            <li class="nav-item">
              <%= link_to 'Donate', donate_path, class: 'nav-link' %>
            </li>
          </ul>
          <div class="d-flex gap-2">
            <% if user_signed_in? %>
              <a class="btn btn-outline-teal"><%= current_user.email %></a>
              <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "btn btn-danger" %>
            <% else %>
              <%= link_to "Login", new_user_session_path, class: "btn btn-outline-teal" %>
              <%= link_to "Register", new_user_registration_path, class: "btn btn-teal text-white" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <%= yield %>

    <!-- Footer -->
    <footer class="bg-light border-top py-5">
      <div class="container">
        <div class="row g-4">
          <div class="col-lg-3 mb-4 mb-lg-0">
            <div class="d-flex align-items-center mb-3">
              <%= image_tag "aasra_logo.jpg", alt: "AASRA Logo", class: "me-2 rounded-circle", style: "height: 40px; width: 40px; object-fit: cover;" %>
              <span class="h4 fw-bold mb-0">AASRA</span>
            </div>
            <p class="text-secondary small">
              Connecting animals in need with loving forever homes since 2025.
            </p>
            <div class="d-flex gap-3 mt-3">
              <a href="#" class="text-secondary hover-text-teal"><i class="bi bi-facebook fs-5"></i></a>
              <a href="#" class="text-secondary hover-text-teal"><i class="bi bi-twitter fs-5"></i></a>
              <a href="#" class="text-secondary hover-text-teal"><i class="bi bi-instagram fs-5"></i></a>
            </div>
          </div>

          <div class="col-6 col-md-3">
            <h5 class="small text-uppercase fw-bold mb-3">Navigation</h5>
            <ul class="list-unstyled">
              <li class="mb-2"><%= link_to "Home", root_path, class: "text-secondary text-decoration-none hover-text-teal" %></li>
              <li class="mb-2"><%= link_to "Adopt", adoptions_path, class: "text-secondary text-decoration-none hover-text-teal" %></li>
              <li class="mb-2"><%= link_to "Rescue", new_rescue_path, class: "text-secondary text-decoration-none hover-text-teal" %></li>
              <li class="mb-2"><%= link_to "Shelters", shelters_path, class: "text-secondary text-decoration-none hover-text-teal" %></li>
              <li class="mb-2"><%= link_to "Donate", donate_path, class: "text-secondary text-decoration-none hover-text-teal" %></li>
            </ul>
          </div>

          <div class="col-6 col-md-3">
          <h5 class="small text-uppercase fw-bold mb-3">Get Involved</h5>
          <ul class="list-unstyled">
            <li class="mb-2"><%= link_to 'Volunteers', volunteers_path, class: 'text-secondary text-decoration-none hover-text-teal' %></li>
            <li class="mb-2"><%= link_to 'Foster', fosters_index_path, class: 'text-secondary text-decoration-none hover-text-teal' %></li>
            <li class="mb-2"><%= link_to 'Events', events_path, class: 'text-secondary text-decoration-none hover-text-teal' %></li>
          </ul>
        </div>

          <div class="col-md-3">
            <h5 class="small text-uppercase fw-bold mb-3">Contact Us</h5>
            <ul class="list-unstyled">
              <li class="d-flex mb-2"><i class="bi bi-telephone me-2 text-secondary"></i><span class="text-secondary">(555) 123-4567</span></li>
              <li class="d-flex mb-2"><i class="bi bi-envelope me-2 text-secondary"></i><span class="text-secondary">info@aasrarescueandadoptions.com</span></li>
              <li class="d-flex"><i class="bi bi-geo-alt me-2 text-secondary"></i><span class="text-secondary">123 Rescue Lane<br>Animal City, AC 12345</span></li>
            </ul>
          </div>
        </div>

        <div class="border-top pt-4 mt-4 text-center">
          <p class="text-secondary small">
            &copy; <span id="current-year"><%= Time.current.year %></span> AASRA. All rights reserved.
          </p>
          <div class="d-flex justify-content-center gap-4">
            <%= link_to "Privacy Policy", privacy_path, class: "text-secondary small text-decoration-none hover-text-teal" %>
            <%= link_to "Terms of Service", terms_path, class: "text-secondary small text-decoration-none hover-text-teal" %>
          </div>
        </div>
      </div>
    </footer>

    <!-- Scripts -->
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <%= javascript_include_tag "animal-details", "data-turbo-track": "reload" %>
  </body>
</html>
