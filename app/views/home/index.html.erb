<section class="hero-section position-relative overflow-hidden">
  <div class="paw-pattern position-absolute inset-0 opacity-20"></div>
  <div class="container py-5 py-md-6 position-relative z-10">
    <div class="row align-items-center">
      <div class="col-md-6 text-center text-md-start">
        <h1 class="display-4 fw-bold text-dark">
          <span class="text-teal">Find a Forever Friend</span>
          <span class="d-block">Save a Life Today</span>
        </h1>
        <p class="lead text-secondary my-4">
          Join our mission to rescue, rehabilitate, and rehome animals in need. 
          Whether you want to adopt, volunteer, or donate - you can make a difference.
        </p>
        <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center justify-content-md-start">
        <%= link_to '<i class="bi bi-heart me-2"></i> Adopt Now'.html_safe, adoptions_path, class: "btn btn-teal text-white btn-lg" %>

           <%# <i class="bi bi-heart me-2"></i> Adopt Now %>
          </a>
          
        </div>
      </div>
      <div class="col-md-6 d-none d-md-block">
        <div class="hero-image rounded-4 mt-5 mt-md-0 shadow-lg"></div>
      </div>
    </div>
  </div>
  
  <div class="container-fluid px-0">
  <div class="row g-0 border-top border-light">

  <%= link_to adoptions_path, class: "col-6 col-md-4 p-4 text-center hover-bg-light text-decoration-none text-dark" do %>
    <i class="bi bi-heart text-orange fs-1 mb-3"></i>
    <h3 class="h5 fw-semibold">Adopt</h3>
    <p class="small text-secondary">Find your perfect companion</p>
  <% end %>
  

   <%= link_to rescues_path, class: "col-6 col-md-4 p-4 text-center border-start hover-bg-light text-decoration-none text-dark" do %>
  <i class="bi bi-github text-teal fs-1 mb-3"></i>
  <h3 class="h5 fw-semibold">Rescue</h3>
  <p class="small text-secondary">Help animals in need</p>
<% end %>


    <a href="donate.html" class="col-6 col-md-4 p-4 text-center border-start hover-bg-light text-decoration-none text-dark">
      <i class="bi bi-currency-dollar text-success fs-1 mb-3"></i>
      <h3 class="h5 fw-semibold">Donate</h3>
      <p class="small text-secondary">Support our mission</p>
    </a>

  </div>
</div>

    
</section>

<!-- Featured Animals Section -->
<section class="py-5 bg-white">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="display-5 fw-bold text-dark">Meet Our Animals</h2>
      <p class="lead text-secondary mx-auto" style="max-width: 700px;">
        These adorable friends are waiting for their forever homes. Could you be their perfect match?
      </p>
    </div>
    
    <div class="row g-4" id="featured-animals">
      <!-- Animal cards will be loaded here via JavaScript -->
    </div>
    
    <div class="text-center mt-5">
    <%= link_to "See All Animals <i class='bi bi-arrow-right ms-2'></i>".html_safe, adoptions_path, class: "btn btn-teal btn-lg text-white" %>

    </div>
  </div>
</section>

<!-- Mission Section -->
<section class="py-5 bg-light">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="display-5 fw-bold text-dark">Our Mission</h2>
      <p class="lead text-secondary mx-auto" style="max-width: 700px;">
        We are dedicated to finding loving homes for animals in need and supporting our community through education and outreach.
      </p>
    </div>
    
    <div class="row g-4">
      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm text-center p-4">
          <div class="rounded-circle bg-teal-soft p-3 d-inline-flex mx-auto mb-4" style="width: 80px; height: 80px;">
            <i class="bi bi-heart text-teal fs-1 m-auto"></i>
          </div>
          <h3 class="h4 fw-semibold">Compassionate Care</h3>
          <p class="text-secondary">
            We provide shelter, medical care, and rehabilitation for animals who have been abandoned, abused, or surrendered.
          </p>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm text-center p-4">
          <div class="rounded-circle bg-orange-soft p-3 d-inline-flex mx-auto mb-4" style="width: 80px; height: 80px;">
            <i class="bi bi-github text-orange fs-1 m-auto"></i>
          </div>
          <h3 class="h4 fw-semibold">Responsible Adoption</h3>
          <p class="text-secondary">
            Our thorough adoption process ensures animals are matched with families who can provide lifelong care and love.
          </p>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm text-center p-4">
          <div class="rounded-circle bg-purple-soft p-3 d-inline-flex mx-auto mb-4" style="width: 80px; height: 80px;">
            <i class="bi bi-shield-check text-purple fs-1 m-auto"></i>
          </div>
          <h3 class="h4 fw-semibold">Community Education</h3>
          <p class="text-secondary">
            We educate the public about animal welfare, responsible pet ownership, and the importance of spaying and neutering.
          </p>
        </div>
      </div>
    </div>
    
    <div class="row mt-5">
      <div class="col-12">
        <div class="card border-0 shadow-sm overflow-hidden">
          <div class="row g-0">
            <div class="col-lg-6 p-4 p-lg-5 d-flex flex-column justify-content-center">
              <h3 class="h2 fw-bold mb-4">Our Impact</h3>
              <p class="text-secondary mb-4">
                Since our founding, we've helped thousands of animals find their forever homes and provided support to countless more through our community programs.
              </p>
              
              <div class="row g-4">
                <div class="col-6">
                  <p class="h2 fw-bold text-teal mb-0">5,000+</p>
                  <p class="text-secondary small">Animals Rescued</p>
                </div>
                <div class="col-6">
                  <p class="h2 fw-bold text-orange mb-0">4,500+</p>
                  <p class="text-secondary small">Adoptions</p>
                </div>
                <div class="col-6">
                  <p class="h2 fw-bold text-purple mb-0">1,200+</p>
                  <p class="text-secondary small">Volunteers</p>
                </div>
                <div class="col-6">
                  <p class="h2 fw-bold text-success mb-0">10+</p>
                  <p class="text-secondary small">Partner Shelters</p>
                </div>
              </div>
            </div>
            <div class="col-lg-6 impact-image d-none d-lg-block" style="min-height: 400px;"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- User Roles Section -->
<section class="py-5 bg-white">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="display-5 fw-bold text-dark">How You Can Help</h2>
      <p class="lead text-secondary mx-auto" style="max-width: 700px;">
        There are many ways to make a difference in the lives of animals in need. Find the role that's right for you.
      </p>
    </div>
    
    <div class="row g-4">
      <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-light rounded-3 shadow-sm p-4 text-center">
          <div class="rounded-circle bg-teal-soft p-3 d-inline-flex mx-auto mb-4" style="width: 80px; height: 80px;">
            <i class="bi bi-heart text-teal fs-1 m-auto"></i>
          </div>
          <h3 class="h4 fw-semibold">Adopter</h3>
          <p class="text-secondary mb-4">
            Open your heart and home to an animal in need by adopting a new family member.
          </p>
          <div class="mt-auto">
          <a href="<%= adoptions_path %>" class="btn btn-outline-teal">Find a Pet</a>
          </div>
        </div>
      </div>
      
      <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-light rounded-3 shadow-sm p-4 text-center">
          <div class="rounded-circle bg-orange-soft p-3 d-inline-flex mx-auto mb-4" style="width: 80px; height: 80px;">
            <i class="bi bi-search text-orange fs-1 m-auto"></i>
          </div>
          <h3 class="h4 fw-semibold">Rescuer</h3>
          <p class="text-secondary mb-4">
            Help us locate, rescue, and transport animals in need to safety and care.
          </p>
          <div class="mt-auto">
          <a href="<%= new_rescue_path %>" class="btn btn-outline-orange">Report Animal</a>

          </div>
        </div>
      </div>
      
      <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-light rounded-3 shadow-sm p-4 text-center">
          <div class="rounded-circle bg-purple-soft p-3 d-inline-flex mx-auto mb-4" style="width: 80px; height: 80px;">
            <i class="bi bi-people text-purple fs-1 m-auto"></i>
          </div>
          <h3 class="h4 fw-semibold">Volunteer</h3>
          <p class="text-secondary mb-4">
            Donate your time and skills to help with animal care, events, and administration.
          </p>
          <div class="mt-auto">
            <a href="volunteer.html" class="btn btn-outline-purple">Join Us</a>
          </div>
        </div>
      </div>
      
      <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-light rounded-3 shadow-sm p-4 text-center">
          <div class="rounded-circle bg-success-soft p-3 d-inline-flex mx-auto mb-4" style="width: 80px; height: 80px;">
            <i class="bi bi-currency-dollar text-success fs-1 m-auto"></i>
          </div>
          <h3 class="h4 fw-semibold">Donor</h3>
          <p class="text-secondary mb-4">
            Support our mission with financial contributions to fund medical care, food, and shelter.
          </p>
          <div class="mt-auto">
            <a href="donate.html" class="btn btn-outline-success">Donate Now</a>
          </div>
        </div>
      </div>
    </div>
    
    <div class="mt-5">
      <div class="card border-0 p-5 text-center bg-gradient-to-r rounded-4">
        <h3 class="h2 fw-bold mb-3">Ready to Make a Difference?</h3>
        <p class="lead text-dark mx-auto mb-4" style="max-width: 700px;">
          Sign up today to create your account and start your journey as an adopter, rescuer, volunteer, or donor.
        </p>
        <div>
        <a href="<%= adoptions_path %>" class="btn btn-teal">Get Started</a>

        </div>
      </div>
    </div>
  </div>
</section>
