<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Donate</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
</head>
<body>

<header class="bg-gradient-to-r py-5">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <h1 class="display-5 fw-bold mb-3">Support Our Mission</h1>
        <p class="lead mb-4">Your donations help us rescue, rehabilitate, and rehome animals in need.</p>
        <div class="d-flex gap-2">
          <a href="#donate-section" class="btn btn-success">Donate Now</a>
          <a href="#ways-to-give" class="btn btn-outline-success">Ways to Give</a>
        </div>
      </div>
      <div class="col-lg-6 mt-4 mt-lg-0">
        <img src="https://images.unsplash.com/photo-1517022812141-23620dba5c23?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" class="img-fluid rounded-3 shadow">
      </div>
    </div>
  </div>
</header>

<section class="py-5 bg-light">
  <div class="container">
    <h2 class="text-center mb-5">Your Donation Makes an Impact</h2>
    <div class="row g-4 text-center">
      <% [25, 50, 100, 250].each do |amt| %>
        <div class="col-md-3">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
              <div class="display-4 text-success mb-3">Rs.<%= amt %></div>
              <p><%= case amt
                  when 25 then "Feeds a shelter animal for a month"
                  when 50 then "Covers basic vaccinations"
                  when 100 then "Funds spay/neuter surgery"
                  when 250 then "Covers emergency medical care"
                end %>
              </p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section id="donate-section" class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
          <div class="card-body p-4">
            <h2 class="card-title text-center mb-4">Make a Donation</h2>
            <%= form_with model: @donation, url: donations_path, local: true do |f| %>
              <% if @donation.errors.any? %>
                <div class="alert alert-danger">
                  <ul>
                    <% @donation.errors.full_messages.each do |msg| %>
                      <li><%= msg %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>

              <!-- Amount -->
              <div class="mb-4">
                <label class="form-label">Select Amount</label>
                <div class="row g-2">
                  <% [25, 50, 100, 250].each do |amt| %>
                    <div class="col-6 col-md-3">
                      <div class="form-check">
                        <%= f.radio_button :amount, amt, checked: amt == 25, class: "form-check-input", id: "amount#{amt}" %>
                        <label for="amount<%= amt %>" class="form-check-label w-100 btn btn-outline-success">
                          Rs.<%= amt %>
                        </label>
                      </div>
                    </div>
                  <% end %>
                  <div class="col-12 mt-2">
                    <%= f.label :amount, "Custom Amount", class: "form-label" %>
                    <%= f.number_field :amount, placeholder: "Enter custom amount", class: "form-control" %>
                  </div>
                </div>
              </div>

              <!-- Frequency -->
              <div class="mb-4">
                <label class="form-label">Donation Frequency</label>
                <div class="row g-2">
                  <div class="col-6">
                    <%= f.radio_button :frequency, "one-time", checked: true, class: "form-check-input", id: "oneTime" %>
                    <label class="form-check-label w-100 btn btn-outline-success" for="oneTime">One-time</label>
                  </div>
                  <div class="col-6">
                    <%= f.radio_button :frequency, "monthly", class: "form-check-input", id: "monthly" %>
                    <label class="form-check-label w-100 btn btn-outline-success" for="monthly">Monthly</label>
                  </div>
                </div>
              </div>

              <!-- Personal Info -->
              <div class="row g-3 mb-4">
                <div class="col-md-6">
                  <%= f.label :first_name, "First Name" %>
                  <%= f.text_field :first_name, class: "form-control", required: true %>
                </div>
                <div class="col-md-6">
                  <%= f.label :last_name, "Last Name" %>
                  <%= f.text_field :last_name, class: "form-control", required: true %>
                </div>
                <div class="col-md-6">
                  <%= f.label :email %>
                  <%= f.email_field :email, class: "form-control", required: true %>
                </div>
                <div class="col-md-6">
                  <%= f.label :phone %>
                  <%= f.telephone_field :phone, class: "form-control" %>
                </div>
              </div>

              <!-- Dedication -->
              <div class="mb-4">
                <div class="form-check">
                <%= f.check_box :dedicated, { class: "form-check-input", id: "dedicationCheck" }, 'true', 'false' %>

                  <label class="form-check-label" for="dedicationCheck">Dedicate this donation</label>
                </div>
              </div>

              <!-- Submit -->
              <div class="d-grid">
                <%= f.submit "Complete Donation", class: "btn btn-success py-3 fw-bold" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="ways-to-give" class="py-5 bg-light">
  <div class="container">
    <h2 class="text-center mb-5">Other Ways to Support</h2>
    <div class="row g-4 text-center">
      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
          <div class="card-body p-4">
            <i class="bi bi-gift-fill text-success fs-1 mb-3"></i>
            <h3 class="h4 mb-3">Monthly Giving</h3>
            <p>Provide consistent support with recurring donations.</p>
            <a href="#" class="btn btn-outline-success">Learn More</a>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
          <div class="card-body p-4">
            <i class="bi bi-box-seam-fill text-warning fs-1 mb-3"></i>
            <h3 class="h4 mb-3">In-Kind Donations</h3>
            <p>Donate food, bedding, and more to shelters.</p>
            <a href="#" class="btn btn-outline-success">View Wishlist</a>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
          <div class="card-body p-4">
            <i class="bi bi-building-fill text-primary fs-1 mb-3"></i>
            <h3 class="h4 mb-3">Corporate Giving</h3>
            <p>Partner through matching gifts or sponsorships.</p>
            <a href="#" class="btn btn-outline-success">Partner With Us</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
